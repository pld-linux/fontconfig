+static FcBool
+build_config (FcConfig *config, json_object *obj)
+{
+    int    n, i;
+    FcBool ret = FcTrue;
+
+    n = json_object_array_length (obj);
+    for (i = 0; i < n; i++) {
+	json_object   *o = json_object_array_get_idx (obj, i);
