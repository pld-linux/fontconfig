+		    if (FcStrStrIgnoreCase (v.u.s, (FcChar8 *)"mono")) {
+			generic_family = FC_FAMILY_MONO;
+			break;
+		    } else if (FcStrStrIgnoreCase (v.u.s, (FcChar8 *)"sans")) {
+			generic_family = FC_FAMILY_SANS;
