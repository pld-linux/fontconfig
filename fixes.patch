+	    s = allocated;
+	}
+	ret = FcConfigParseAndLoad (config, (const FcChar8 *)s, FcTrue);
+	if (allocated) {
+	    free (allocated);
+	    allocated = NULL;
+	}
+	if (!ret)
+	    goto bail;
+    }
+bail:
+    return ret;
